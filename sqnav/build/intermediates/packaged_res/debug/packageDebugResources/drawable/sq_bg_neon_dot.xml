<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Soft Purple Glow -->
    <item>
        <shape android:shape="oval">
            <size android:width="8dp" android:height="8dp" />
            <solid android:color="#50D4BBFF" />
        </shape>
    </item>
    <!-- Solid Glowing Purple Core -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="oval">
            <size android:width="4dp" android:height="4dp" />
            <solid android:color="#D4BBFF" />
            <stroke
                android:width="0.5dp"
                android:color="#EBDCFF" />
        </shape>
    </item>
</layer-list>
